#!/usr/bin/env node
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import {
  bindRequiredBodySha256,
  formatRequiredBodySha256Posture,
} from '../lib/artifact-required-sha.mjs';
import {
  assertNoUnsafeProtectedRecordsRuntimeProfileText,
} from '../lib/protected-records-runtime-profile.mjs';
import {
  assertProtectedRecordsCurrentFixtureAuthorityGrantFreshEffectAllowed,
} from '../lib/protected-records-fixture-authority-status.mjs';
import {
  assertProtectedRecordsRuntimePreflightProfile,
} from '../lib/protected-records-runtime-profile-preflight.mjs';
import {
  assertProtectedRecordsRuntimeProfileInstallationPlan,
} from '../lib/protected-records-runtime-profile-installation.mjs';
import {
  SAMPLE_PLAN_DISPLAY_PATH,
  SAMPLE_PROFILE_DISPLAY_PATH,
  readProtectedRecordsInstalledSamplePlan,
  readProtectedRecordsInstalledSampleProfile,
} from '../lib/protected-records-installed-proof-samples.mjs';
import {
  assertProtectedRecordsInstalledRuntimeProfileTerminalChain,
  assertProtectedRecordsInstalledRuntimeProfileTerminalChainArtifact,
  buildProtectedRecordsInstalledRuntimeProfileTerminalChainArtifact,
  formatProtectedRecordsInstalledRuntimeProfileTerminalChainArtifactSummary,
  formatProtectedRecordsInstalledRuntimeProfileTerminalChainArtifactVerification,
  formatProtectedRecordsInstalledRuntimeProfileTerminalChainSummary,
  parseProtectedRecordsInstalledRuntimeProfileTerminalChainArtifactText,
  runProtectedRecordsInstalledRuntimeProfileTerminalChain,
  verifyProtectedRecordsInstalledRuntimeProfileTerminalChainArtifact,
  writeProtectedRecordsInstalledRuntimeProfileTerminalChainArtifact,
} from '../lib/protected-records-installed-runtime-profile-terminal-chain.mjs';

const SAMPLE_ARTIFACT_DISPLAY_PATH =
  'tests/fixtures/protected-records-installed-runtime-profile-terminal-chain-artifact-v1.json';
const SAMPLE_ARTIFACT_PATH = fileURLToPath(new URL(`../${SAMPLE_ARTIFACT_DISPLAY_PATH}`, import.meta.url));

function usage() {
  console.error('Usage: zlar protected-records-installed-runtime-profile-terminal-chain (--sample|--plan <file|-> --profile <file|->) [--json] [--artifact <file|->]');
  console.error('       zlar protected-records-installed-runtime-profile-terminal-chain verify (--input <file|->|--sample) [--json] [--require-sha <artifact_body_sha256>]');
  console.error('Runs a proof-only local disposable protected-records installed runtime-profile terminal-chain proof.');
  console.error('Use --sample as the first safe run: it uses canonical sample plan/profile inputs while generating fresh launcher-owned disposable chain evidence.');
  console.error('Use --artifact <file> to write a portable checksummed terminal-chain artifact, or --artifact - to print it.');
  console.error('Use verify --input <file|-> to verify a supplied terminal-chain artifact without rerunning the chain.');
  console.error('Use verify --sample to verify the committed sample terminal-chain artifact without generating new evidence.');
  console.error('Fresh chain generation refuses while the exact one-use fixture authority grant is exhausted.');
  console.error('Use verify --require-sha <artifact_body_sha256> to refuse a valid artifact whose body hash is not the expected artifact identity.');
  console.error(`Sample plan: ${SAMPLE_PLAN_DISPLAY_PATH}`);
  console.error(`Sample profile: ${SAMPLE_PROFILE_DISPLAY_PATH}`);
  console.error(`Sample artifact: ${SAMPLE_ARTIFACT_DISPLAY_PATH}`);
  console.error('This command does not persistently install, activate, write hook/user/machine configuration, select --latest, inspect a live records system, prove current-machine governance, or claim production downstream recognition.');
}

function safeErrorMessage(message) {
  try {
    assertNoUnsafeProtectedRecordsRuntimeProfileText(message);
    return message;
  } catch {
    return 'Protected records installed runtime profile terminal chain failed; private path or credential details were suppressed.';
  }
}

function die(message, code = 1) {
  console.error(`ERROR: ${safeErrorMessage(message)}`);
  process.exit(code);
}

function readTextInput(path, label) {
  try {
    return path === '-' ? readFileSync(0, 'utf8') : readFileSync(path, 'utf8');
  } catch {
    die(`Could not read protected records installed runtime profile terminal chain ${label}.`);
  }
}

function readJsonInput(path, label) {
  let text = '';
  try {
    text = path === '-' ? readFileSync(0, 'utf8') : readFileSync(path, 'utf8');
  } catch {
    die(`Could not read protected records installed runtime profile terminal chain ${label}.`);
  }
  try {
    return JSON.parse(text);
  } catch (err) {
    die(`Could not parse protected records installed runtime profile terminal chain ${label} JSON: ${err.message}`);
  }
}

function readSampleArtifact() {
  try {
    return readFileSync(SAMPLE_ARTIFACT_PATH, 'utf8');
  } catch {
    die(`Sample artifact is unavailable at ${SAMPLE_ARTIFACT_DISPLAY_PATH}.`, 2);
  }
}

function runVerifyCommand(argv) {
  let inputPath = '';
  let useSample = false;
  let asJson = false;
  let requiredSha = '';

  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg === '--input') {
      inputPath = argv[++i] || '';
      if (!inputPath) {
        usage();
        die('Missing value for --input.', 2);
      }
    } else if (arg === '--sample') {
      useSample = true;
    } else if (arg === '--json') {
      asJson = true;
    } else if (arg === '--require-sha') {
      requiredSha = argv[++i] || '';
      if (!requiredSha) {
        usage();
        die('Missing value for --require-sha.', 2);
      }
    } else if (arg === '--help' || arg === '-h') {
      usage();
      process.exit(0);
    } else {
      usage();
      die('Unsupported verify option provided.', 2);
    }
  }

  if (inputPath && useSample) {
    usage();
    die('Cannot combine --input with --sample.', 2);
  }
  if (!inputPath && !useSample) {
    usage();
    die('Missing required --input <file|-> or --sample.', 2);
  }

  const artifact = parseProtectedRecordsInstalledRuntimeProfileTerminalChainArtifactText(
    useSample ? readSampleArtifact() : readTextInput(inputPath, 'artifact')
  );
  const baseVerification = verifyProtectedRecordsInstalledRuntimeProfileTerminalChainArtifact(
    artifact,
    { expectedArtifactBodySha256: requiredSha || null }
  );
  const verification = bindRequiredBodySha256(
    baseVerification,
    requiredSha,
    'Protected records installed runtime profile terminal chain artifact'
  );
  const output = asJson
    ? `${JSON.stringify(verification, null, 2)}\n`
    : formatProtectedRecordsInstalledRuntimeProfileTerminalChainArtifactVerification(baseVerification) +
      formatRequiredBodySha256Posture(verification);
  assertNoUnsafeProtectedRecordsRuntimeProfileText(output);
  process.stdout.write(output);
}

const args = process.argv.slice(2);

if (args[0] === 'verify') {
  try {
    runVerifyCommand(args.slice(1));
  } catch (err) {
    die(err.message);
  }
  process.exit(0);
}

let planPath = '';
let profilePath = '';
let useSample = false;
let asJson = false;
let artifactOutput = '';

for (let i = 0; i < args.length; i++) {
  const arg = args[i];
  if (arg === '--plan') {
    planPath = args[++i] || '';
  } else if (arg === '--profile') {
    profilePath = args[++i] || '';
  } else if (arg === '--sample') {
    useSample = true;
  } else if (arg === '--json') {
    asJson = true;
  } else if (arg === '--artifact') {
    artifactOutput = args[++i] || '';
    if (!artifactOutput) {
      usage();
      die('Missing value for --artifact.', 2);
    }
  } else if (arg === '--help' || arg === '-h') {
    usage();
    process.exit(0);
  } else {
    usage();
    die('Unsupported option provided.', 2);
  }
}

if (useSample && (planPath || profilePath)) {
  usage();
  die('Cannot combine --sample with --plan or --profile.', 2);
}
if (!useSample && (!planPath || !profilePath)) {
  usage();
  die('--sample or both --plan and --profile are required; this chain does not select a live, latest, persistent, or current-machine runtime profile.', 2);
}
if (planPath === '-' && profilePath === '-') {
  usage();
  die('--plan - and --profile - cannot both read from stdin.', 2);
}
if (artifactOutput === '-' && asJson) {
  usage();
  die('Cannot combine --json with --artifact -.', 2);
}

try {
  assertProtectedRecordsCurrentFixtureAuthorityGrantFreshEffectAllowed(
    'Protected records installed runtime profile terminal-chain generation'
  );
} catch (err) {
  die(err.message);
}

const plan = useSample
  ? readProtectedRecordsInstalledSamplePlan()
  : readJsonInput(planPath, 'plan');
const profile = useSample
  ? readProtectedRecordsInstalledSampleProfile()
  : readJsonInput(profilePath, 'profile');

try {
  assertProtectedRecordsRuntimeProfileInstallationPlan(plan);
  assertProtectedRecordsRuntimePreflightProfile(profile);
  const report = runProtectedRecordsInstalledRuntimeProfileTerminalChain(plan, profile);
  assertProtectedRecordsInstalledRuntimeProfileTerminalChain(report);
  let output;
  if (artifactOutput === '-') {
    const artifact = buildProtectedRecordsInstalledRuntimeProfileTerminalChainArtifact(report);
    assertProtectedRecordsInstalledRuntimeProfileTerminalChainArtifact(artifact);
    output = `${JSON.stringify(artifact, null, 2)}\n`;
  } else {
    let artifact = null;
    if (artifactOutput) {
      artifact = buildProtectedRecordsInstalledRuntimeProfileTerminalChainArtifact(report);
      writeProtectedRecordsInstalledRuntimeProfileTerminalChainArtifact(artifact, artifactOutput);
    }
    output = asJson
      ? `${JSON.stringify(report, null, 2)}\n`
      : formatProtectedRecordsInstalledRuntimeProfileTerminalChainSummary(report);
    if (artifact) {
      output += formatProtectedRecordsInstalledRuntimeProfileTerminalChainArtifactSummary(artifact);
    }
  }
  assertNoUnsafeProtectedRecordsRuntimeProfileText(output);
  process.stdout.write(output);
} catch (err) {
  die(err.message);
}
