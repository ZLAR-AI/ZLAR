#!/usr/bin/env node
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import {
  bindRequiredBodySha256,
  formatRequiredBodySha256Posture,
} from '../lib/artifact-required-sha.mjs';
import {
  assertNoUnsafeProtectedRecordsServiceProfileText,
  formatProtectedRecordsServiceProfilePreflightArtifactVerification,
  parseProtectedRecordsServiceProfilePreflightArtifactText,
  verifyProtectedRecordsServiceProfilePreflightArtifact,
} from '../lib/protected-records-service-profile.mjs';

const SAMPLE_ARTIFACT_DISPLAY_PATH =
  'tests/fixtures/protected-records-service-preflight-artifact-v1.json';
const SAMPLE_ARTIFACT_PATH = fileURLToPath(new URL(`../${SAMPLE_ARTIFACT_DISPLAY_PATH}`, import.meta.url));

function usage() {
  console.error('Usage: zlar protected-records-service-preflight verify (--input <file|->|--sample) [--json] [--require-sha <artifact_body_sha256>]');
  console.error('Fresh service-profile preflight and artifact generation are permanently retired.');
  console.error('Verification reads a caller-supplied or exact committed historical artifact without rerunning E2.');
  console.error(`Sample artifact: ${SAMPLE_ARTIFACT_DISPLAY_PATH}`);
}

function safeErrorMessage(message) {
  try {
    assertNoUnsafeProtectedRecordsServiceProfileText(message);
    return message;
  } catch {
    return 'Protected records service profile preflight failed; private path or credential details were suppressed.';
  }
}

function die(message, code = 1) {
  console.error(`ERROR: ${safeErrorMessage(message)}`);
  process.exit(code);
}

const args = process.argv.slice(2);

function readTextInput(path, label) {
  try {
    return path === '-' ? readFileSync(0, 'utf8') : readFileSync(path, 'utf8');
  } catch {
    die(`Could not read protected records service profile ${label}.`);
  }
}

function readSampleArtifact() {
  try {
    return readFileSync(SAMPLE_ARTIFACT_PATH, 'utf8');
  } catch {
    die(`Sample artifact is unavailable at ${SAMPLE_ARTIFACT_DISPLAY_PATH}.`, 2);
  }
}

function runVerifyCommand(argv) {
  let inputPath = '';
  let useSample = false;
  let asJson = false;
  let requiredSha = '';

  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg === '--input') {
      inputPath = argv[++i] || '';
      if (!inputPath) {
        usage();
        die('Missing value for --input.', 2);
      }
    } else if (arg === '--sample') {
      useSample = true;
    } else if (arg === '--json') {
      asJson = true;
    } else if (arg === '--require-sha') {
      requiredSha = argv[++i] || '';
      if (!requiredSha) {
        usage();
        die('Missing value for --require-sha.', 2);
      }
    } else if (arg === '--help' || arg === '-h') {
      usage();
      process.exit(0);
    } else {
      usage();
      die('Unsupported verify option provided.', 2);
    }
  }

  if (inputPath && useSample) {
    usage();
    die('Cannot combine --input with --sample.', 2);
  }

  if (!inputPath && !useSample) {
    usage();
    die('Missing required --input <file|-> or --sample.', 2);
  }

  const artifact = parseProtectedRecordsServiceProfilePreflightArtifactText(
    useSample ? readSampleArtifact() : readTextInput(inputPath, 'preflight artifact')
  );
  const baseVerification = verifyProtectedRecordsServiceProfilePreflightArtifact(artifact);
  const verification = bindRequiredBodySha256(
    baseVerification,
    requiredSha,
    'Protected records service profile preflight artifact'
  );
  const output = asJson
    ? `${JSON.stringify(verification, null, 2)}\n`
    : formatProtectedRecordsServiceProfilePreflightArtifactVerification(baseVerification) +
      formatRequiredBodySha256Posture(verification);
  assertNoUnsafeProtectedRecordsServiceProfileText(output);
  process.stdout.write(output);
}

if (args[0] === 'verify') {
  try {
    runVerifyCommand(args.slice(1));
  } catch (err) {
    die(err.message);
  }
  process.exit(0);
}

if (args.some((arg) => arg === '--help' || arg === '-h')) {
  usage();
  process.exit(0);
}

die(
  'Protected records service-profile preflight generation refused: e2_positive_service_preflight_generation_retired',
);
