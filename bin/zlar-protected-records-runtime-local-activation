#!/usr/bin/env node
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import {
  bindRequiredBodySha256,
  formatRequiredBodySha256Posture,
} from '../lib/artifact-required-sha.mjs';
import {
  assertNoUnsafeProtectedRecordsRuntimeProfileText,
} from '../lib/protected-records-runtime-profile.mjs';
import {
  assertProtectedRecordsRuntimePreflightProfile,
} from '../lib/protected-records-runtime-profile-preflight.mjs';
import {
  assertProtectedRecordsRuntimeLocalActivationArtifact,
  assertProtectedRecordsRuntimeLocalActivationPlan,
  assertProtectedRecordsRuntimeLocalActivationProof,
  buildProtectedRecordsRuntimeLocalActivationArtifact,
  formatProtectedRecordsRuntimeLocalActivationArtifactSummary,
  formatProtectedRecordsRuntimeLocalActivationArtifactVerification,
  formatProtectedRecordsRuntimeLocalActivationProofSummary,
  parseProtectedRecordsRuntimeLocalActivationArtifactText,
  runProtectedRecordsRuntimeLocalActivationProof,
  verifyProtectedRecordsRuntimeLocalActivationArtifact,
  writeProtectedRecordsRuntimeLocalActivationArtifact,
} from '../lib/protected-records-runtime-local-activation.mjs';

const SAMPLE_ARTIFACT_DISPLAY_PATH =
  'tests/fixtures/protected-records-runtime-local-activation-artifact-v1.json';
const SAMPLE_ARTIFACT_PATH = fileURLToPath(new URL(`../${SAMPLE_ARTIFACT_DISPLAY_PATH}`, import.meta.url));

function usage() {
  console.error('Usage: zlar protected-records-runtime-local-activation --plan <file|-> --profile <file|-> [--json] [--artifact <file|->]');
  console.error('       zlar protected-records-runtime-local-activation verify (--input <file|->|--sample) [--json] [--require-sha <artifact_body_sha256>]');
  console.error('Positive local-activation generation refuses under the exhausted one-use grant; verify remains read-only historical artifact inspection.');
  console.error('Use --artifact <file> to write a portable checksummed local-activation artifact, or --artifact - to print it.');
  console.error('Use verify --input <file|-> to verify a supplied local-activation artifact without rerunning the proof.');
  console.error('Use verify --sample to verify the committed sample local-activation artifact without generating new evidence.');
  console.error('Use verify --require-sha <artifact_body_sha256> to refuse a valid artifact whose body hash is not the expected artifact identity.');
  console.error(`Sample artifact: ${SAMPLE_ARTIFACT_DISPLAY_PATH}`);
  console.error('This command does not live probe, choose --latest, install a runtime profile, write hook or persistent runtime configuration, use Telegram, inspect a live records system, or claim production deployment.');
}

function safeErrorMessage(message) {
  try {
    assertNoUnsafeProtectedRecordsRuntimeProfileText(message);
    return message;
  } catch {
    return 'Protected records runtime local activation proof failed; private path or credential details were suppressed.';
  }
}

function die(message, code = 1) {
  console.error(`ERROR: ${safeErrorMessage(message)}`);
  process.exit(code);
}

function readJsonInput(path, label) {
  let raw = '';
  try {
    raw = path === '-' ? readFileSync(0, 'utf8') : readFileSync(path, 'utf8');
  } catch {
    die(`Could not read protected records runtime local activation ${label}.`);
  }
  try {
    return JSON.parse(raw);
  } catch (err) {
    die(`Could not parse protected records runtime local activation ${label} JSON: ${err.message}`);
  }
}

function readTextInput(path, label) {
  try {
    return path === '-' ? readFileSync(0, 'utf8') : readFileSync(path, 'utf8');
  } catch {
    die(`Could not read protected records runtime local activation ${label}.`);
  }
}

function readSampleArtifact() {
  try {
    return readFileSync(SAMPLE_ARTIFACT_PATH, 'utf8');
  } catch {
    die(`Sample artifact is unavailable at ${SAMPLE_ARTIFACT_DISPLAY_PATH}.`, 2);
  }
}

function runVerifyCommand(argv) {
  let inputPath = '';
  let useSample = false;
  let asJson = false;
  let requiredSha = '';

  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg === '--input') {
      inputPath = argv[++i] || '';
      if (!inputPath) {
        usage();
        die('Missing value for --input.', 2);
      }
    } else if (arg === '--sample') {
      useSample = true;
    } else if (arg === '--json') {
      asJson = true;
    } else if (arg === '--require-sha') {
      requiredSha = argv[++i] || '';
      if (!requiredSha) {
        usage();
        die('Missing value for --require-sha.', 2);
      }
    } else if (arg === '--help' || arg === '-h') {
      usage();
      process.exit(0);
    } else {
      usage();
      die('Unsupported verify option provided.', 2);
    }
  }

  if (inputPath && useSample) {
    usage();
    die('Cannot combine --input with --sample.', 2);
  }

  if (!inputPath && !useSample) {
    usage();
    die('Missing required --input <file|-> or --sample.', 2);
  }

  const artifact = parseProtectedRecordsRuntimeLocalActivationArtifactText(
    useSample ? readSampleArtifact() : readTextInput(inputPath, 'artifact')
  );
  const baseVerification = verifyProtectedRecordsRuntimeLocalActivationArtifact(artifact);
  const verification = bindRequiredBodySha256(
    baseVerification,
    requiredSha,
    'Protected records runtime local activation artifact'
  );
  const output = asJson
    ? `${JSON.stringify(verification, null, 2)}\n`
    : formatProtectedRecordsRuntimeLocalActivationArtifactVerification(baseVerification) +
      formatRequiredBodySha256Posture(verification);
  assertNoUnsafeProtectedRecordsRuntimeProfileText(output);
  process.stdout.write(output);
}

const args = process.argv.slice(2);

if (args[0] === 'verify') {
  try {
    runVerifyCommand(args.slice(1));
  } catch (err) {
    die(err.message);
  }
  process.exit(0);
}

let planPath = '';
let profilePath = '';
let asJson = false;
let artifactOutput = '';

for (let i = 0; i < args.length; i++) {
  const arg = args[i];
  if (arg === '--plan') {
    planPath = args[++i] || '';
  } else if (arg === '--profile') {
    profilePath = args[++i] || '';
  } else if (arg === '--json') {
    asJson = true;
  } else if (arg === '--artifact') {
    artifactOutput = args[++i] || '';
    if (!artifactOutput) {
      usage();
      die('Missing value for --artifact.', 2);
    }
  } else if (arg === '--help' || arg === '-h') {
    usage();
    process.exit(0);
  } else {
    usage();
    die('Unsupported option provided.', 2);
  }
}

if (!planPath || !profilePath) {
  usage();
  die('--plan and --profile are required; this proof does not select a live, latest, or current-machine runtime profile.', 2);
}
if (planPath === '-' && profilePath === '-') {
  usage();
  die('--plan - and --profile - cannot both read from stdin.', 2);
}
if (artifactOutput === '-' && asJson) {
  usage();
  die('Cannot combine --json with --artifact -.', 2);
}

const plan = readJsonInput(planPath, 'plan');
const profile = readJsonInput(profilePath, 'profile');

try {
  assertProtectedRecordsRuntimeLocalActivationPlan(plan);
  assertProtectedRecordsRuntimePreflightProfile(profile);
  const report = runProtectedRecordsRuntimeLocalActivationProof(plan, profile);
  assertProtectedRecordsRuntimeLocalActivationProof(report, plan, profile);
  let output;
  if (artifactOutput === '-') {
    const artifact = buildProtectedRecordsRuntimeLocalActivationArtifact(plan, profile, report);
    assertProtectedRecordsRuntimeLocalActivationArtifact(artifact);
    output = `${JSON.stringify(artifact, null, 2)}\n`;
  } else {
    let artifact = null;
    if (artifactOutput) {
      artifact = buildProtectedRecordsRuntimeLocalActivationArtifact(plan, profile, report);
      writeProtectedRecordsRuntimeLocalActivationArtifact(artifact, artifactOutput);
    }
    output = asJson
      ? `${JSON.stringify(report, null, 2)}\n`
      : formatProtectedRecordsRuntimeLocalActivationProofSummary(report, plan, profile);
    if (artifact) {
      output += formatProtectedRecordsRuntimeLocalActivationArtifactSummary(artifact);
    }
  }
  assertNoUnsafeProtectedRecordsRuntimeProfileText(output);
  process.stdout.write(output);
} catch (err) {
  die(err.message);
}
