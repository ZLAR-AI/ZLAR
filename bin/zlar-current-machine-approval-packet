#!/usr/bin/env node
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import {
  assertRequiredSha256,
} from '../lib/artifact-required-sha.mjs';
import {
  assertNoUnsafeCurrentMachineApprovalPacketText,
  formatCurrentMachineApprovalPacketVerification,
  parseCurrentMachineApprovalPacketText,
  verifyCurrentMachineApprovalPacket,
} from '../lib/current-machine-approval-packet.mjs';

const SAMPLE_PACKET_DISPLAY_PATH =
  'tests/fixtures/current-machine-approval-packet-claude-code-v1.json';
const SAMPLE_PACKET_PATH = fileURLToPath(new URL(`../${SAMPLE_PACKET_DISPLAY_PATH}`, import.meta.url));

function usage() {
  console.error('Usage: zlar current-machine-approval-packet verify (--input <file|->|--sample) [--json] [--require-packet-sha <packet_sha256>]');
  console.error('Verifies that a selected Claude Code approval packet is complete before install/config authority is requested.');
  console.error('Use --require-packet-sha <packet_sha256> to refuse a valid packet whose packet hash is not the expected packet identity.');
  console.error(`Sample packet: ${SAMPLE_PACKET_DISPLAY_PATH}`);
  console.error('This command reads only the supplied packet or committed sample. It does not install, activate, write hook/profile/user/machine configuration, use Telegram, touch secrets/signing material, live probe the machine, mint receipts, or prove current-machine governance.');
}

function safeErrorMessage(message) {
  try {
    assertNoUnsafeCurrentMachineApprovalPacketText(message);
    return message;
  } catch {
    return 'Current-machine approval packet verification failed; private path or credential details were suppressed.';
  }
}

function die(message, code = 1) {
  console.error(`ERROR: ${safeErrorMessage(message)}`);
  process.exit(code);
}

function readTextInput(path, label) {
  try {
    return path === '-' ? readFileSync(0, 'utf8') : readFileSync(path, 'utf8');
  } catch {
    die(`Could not read current-machine approval packet ${label}.`);
  }
}

function readSamplePacket() {
  try {
    return readFileSync(SAMPLE_PACKET_PATH, 'utf8');
  } catch {
    die(`Sample packet is unavailable at ${SAMPLE_PACKET_DISPLAY_PATH}.`, 2);
  }
}

const args = process.argv.slice(2);
if (args[0] !== 'verify') {
  if (args[0] === '--help' || args[0] === '-h') {
    usage();
    process.exit(0);
  }
  usage();
  die('Missing required verify subcommand.', 2);
}

let inputPath = '';
let useSample = false;
let asJson = false;
let requiredPacketSha = '';

for (let i = 1; i < args.length; i++) {
  const arg = args[i];
  if (arg === '--input') {
    inputPath = args[++i] || '';
    if (!inputPath) {
      usage();
      die('Missing value for --input.', 2);
    }
  } else if (arg === '--sample') {
    useSample = true;
  } else if (arg === '--json') {
    asJson = true;
  } else if (arg === '--require-packet-sha') {
    requiredPacketSha = args[++i] || '';
    if (!requiredPacketSha) {
      usage();
      die('Missing value for --require-packet-sha.', 2);
    }
  } else if (arg === '--help' || arg === '-h') {
    usage();
    process.exit(0);
  } else {
    usage();
    die('Unsupported verify option provided.', 2);
  }
}

if (inputPath && useSample) {
  usage();
  die('Cannot combine --input with --sample.', 2);
}

if (!inputPath && !useSample) {
  usage();
  die('Missing required --input <file|-> or --sample.', 2);
}

try {
  const packet = parseCurrentMachineApprovalPacketText(
    useSample ? readSamplePacket() : readTextInput(inputPath, 'input')
  );
  const baseVerification = verifyCurrentMachineApprovalPacket(packet);
  let verification = baseVerification;
  if (requiredPacketSha) {
    assertRequiredSha256(requiredPacketSha, '--require-packet-sha');
    if (baseVerification.packet_sha256 !== requiredPacketSha) {
      throw new Error('Current-machine approval packet SHA-256 does not match required --require-packet-sha value');
    }
    verification = {
      ...baseVerification,
      required_packet_sha256: requiredPacketSha,
      required_packet_sha256_matched: true,
    };
  }
  const output = asJson
    ? `${JSON.stringify(verification, null, 2)}\n`
    : formatCurrentMachineApprovalPacketVerification(baseVerification) +
      (requiredPacketSha
        ? `required_packet_sha256=${requiredPacketSha}\nrequired_packet_sha256_matched=true\n`
        : '');
  assertNoUnsafeCurrentMachineApprovalPacketText(output);
  process.stdout.write(output);
} catch (err) {
  die(err.message);
}
