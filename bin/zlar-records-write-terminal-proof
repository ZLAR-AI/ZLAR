#!/usr/bin/env node
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import {
  assertNoUnsafeProtectedRecordsRuntimeProfileText,
} from '../lib/protected-records-runtime-profile.mjs';
import {
  assertProtectedRecordsRuntimeLocalActivationPlan,
} from '../lib/protected-records-runtime-local-activation.mjs';
import {
  assertRecordsWriteTerminalProof,
  buildRecordsWriteTerminalProof,
  formatRecordsWriteTerminalProofSummary,
} from '../lib/records-write-terminal-proof.mjs';

const DEFAULT_PLAN_DISPLAY_PATH = 'profiles/protected-records-runtime-local-activation-plan.fixture.json';
const DEFAULT_PROFILE_DISPLAY_PATH = 'profiles/protected-records-runtime-fixture.profile.json';
const DEFAULT_PLAN_PATH = fileURLToPath(new URL(`../${DEFAULT_PLAN_DISPLAY_PATH}`, import.meta.url));
const DEFAULT_PROFILE_PATH = fileURLToPath(new URL(`../${DEFAULT_PROFILE_DISPLAY_PATH}`, import.meta.url));

function usage() {
  console.error('Usage: zlar records-write-terminal-proof [--json] [--plan <file|-> --profile <file|->]');
  console.error('The exact one-use fixture grant is exhausted. This command refuses before nested runtime proof execution.');
  console.error(`Default plan: ${DEFAULT_PLAN_DISPLAY_PATH}`);
  console.error(`Default profile: ${DEFAULT_PROFILE_DISPLAY_PATH}`);
  console.error('No fresh proof evidence or fixture-rightful projection is generated. Historical artifacts require their read-only verifier surfaces.');
  console.error('It does not install a runtime profile, write hooks, write persistent runtime config, use Telegram, inspect a live records system, prove current-machine governance, prove production authority, or provide external attestation.');
}

function safeErrorMessage(message) {
  try {
    assertNoUnsafeProtectedRecordsRuntimeProfileText(message);
    return message;
  } catch {
    return 'Records.write one-terminal proof failed; private path or credential details were suppressed.';
  }
}

function die(message, code = 1) {
  console.error(`ERROR: ${safeErrorMessage(message)}`);
  process.exit(code);
}

function readJsonInput(path, label) {
  let raw = '';
  try {
    raw = path === '-' ? readFileSync(0, 'utf8') : readFileSync(path, 'utf8');
  } catch {
    die(`Could not read records.write terminal proof ${label}.`);
  }
  try {
    return JSON.parse(raw);
  } catch (err) {
    die(`Could not parse records.write terminal proof ${label} JSON: ${err.message}`);
  }
}

let planPath = DEFAULT_PLAN_PATH;
let profilePath = DEFAULT_PROFILE_PATH;
let asJson = false;

const args = process.argv.slice(2);
for (let i = 0; i < args.length; i++) {
  const arg = args[i];
  if (arg === '--plan') {
    planPath = args[++i] || '';
    if (!planPath) {
      usage();
      die('Missing value for --plan.', 2);
    }
  } else if (arg === '--profile') {
    profilePath = args[++i] || '';
    if (!profilePath) {
      usage();
      die('Missing value for --profile.', 2);
    }
  } else if (arg === '--json') {
    asJson = true;
  } else if (arg === '--help' || arg === '-h') {
    usage();
    process.exit(0);
  } else {
    usage();
    die('Unsupported option provided.', 2);
  }
}

if (planPath === '-' && profilePath === '-') {
  usage();
  die('--plan - and --profile - cannot both read from stdin.', 2);
}

try {
  const plan = readJsonInput(planPath, 'plan');
  const profile = readJsonInput(profilePath, 'profile');
  assertProtectedRecordsRuntimeLocalActivationPlan(plan);
  const proof = buildRecordsWriteTerminalProof(plan, profile);
  assertRecordsWriteTerminalProof(proof);
  const output = asJson
    ? `${JSON.stringify(proof, null, 2)}\n`
    : formatRecordsWriteTerminalProofSummary(proof);
  assertNoUnsafeProtectedRecordsRuntimeProfileText(output);
  process.stdout.write(output);
} catch (err) {
  die(err.message);
}
