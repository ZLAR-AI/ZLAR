#!/usr/bin/env node
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import {
  bindRequiredBodySha256,
  formatRequiredBodySha256Posture,
} from '../lib/artifact-required-sha.mjs';
import {
  assertNoUnsafeProtectedRecordsRuntimeProfileText,
} from '../lib/protected-records-runtime-profile.mjs';
import {
  assertProtectedRecordsCurrentFixtureAuthorityGrantFreshEffectAllowed,
} from '../lib/protected-records-fixture-authority-status.mjs';
import {
  parseProtectedRecordsInstalledRuntimeProfilePreflightArtifactText,
} from '../lib/protected-records-installed-runtime-profile-preflight.mjs';
import {
  SAMPLE_PREFLIGHT_ARTIFACT_DISPLAY_PATH,
  readCanonicalProtectedRecordsInstalledPreflightSampleArtifactText,
} from '../lib/protected-records-installed-proof-samples.mjs';
import {
  assertProtectedRecordsInstalledRuntimeProfileServiceProofArtifact,
  assertProtectedRecordsInstalledRuntimeProfileServiceProof,
  buildProtectedRecordsInstalledRuntimeProfileServiceProofArtifact,
  formatProtectedRecordsInstalledRuntimeProfileServiceProofArtifactSummary,
  formatProtectedRecordsInstalledRuntimeProfileServiceProofArtifactVerification,
  formatProtectedRecordsInstalledRuntimeProfileServiceProofSummary,
  parseProtectedRecordsInstalledRuntimeProfileServiceProofArtifactText,
  runProtectedRecordsInstalledRuntimeProfileServiceProof,
  verifyProtectedRecordsInstalledRuntimeProfileServiceProofArtifact,
  writeProtectedRecordsInstalledRuntimeProfileServiceProofArtifact,
} from '../lib/protected-records-installed-runtime-profile-service-proof.mjs';

const SAMPLE_ARTIFACT_DISPLAY_PATH = SAMPLE_PREFLIGHT_ARTIFACT_DISPLAY_PATH;
const SAMPLE_PROOF_ARTIFACT_DISPLAY_PATH =
  'tests/fixtures/protected-records-installed-runtime-profile-service-proof-artifact-v1.json';
const SAMPLE_PROOF_ARTIFACT_PATH = fileURLToPath(new URL(`../${SAMPLE_PROOF_ARTIFACT_DISPLAY_PATH}`, import.meta.url));

function usage() {
  console.error('Usage: zlar protected-records-installed-runtime-profile-service-proof (--input <file|->|--sample) [--json] [--artifact <file|->]');
  console.error('       zlar protected-records-installed-runtime-profile-service-proof verify (--input <file|->|--sample) [--json] [--require-sha <artifact_body_sha256>]');
  console.error('Consumes a verified installed-runtime-profile preflight artifact and proves the selected profile through a local disposable runtime-service child process.');
  console.error('Use --artifact <file> to write a portable checksummed service-proof artifact, or --artifact - to print it.');
  console.error('Use verify --input <file|-> to verify a supplied service-proof artifact without rerunning the proof.');
  console.error('Use verify --sample to verify the committed sample service-proof artifact without generating new evidence.');
  console.error('Fresh proof generation refuses while the exact one-use fixture authority grant is exhausted.');
  console.error('Use verify --require-sha <artifact_body_sha256> to refuse a valid artifact whose body hash is not the expected artifact identity.');
  console.error(`Sample preflight artifact: ${SAMPLE_ARTIFACT_DISPLAY_PATH}`);
  console.error(`Sample proof artifact: ${SAMPLE_PROOF_ARTIFACT_DISPLAY_PATH}`);
  console.error('This command does not install, activate, write hook/user/machine configuration, start a live runtime service, inspect a live records system, select --latest, prove current-machine governance, or claim production downstream recognition.');
}

function safeErrorMessage(message) {
  try {
    assertNoUnsafeProtectedRecordsRuntimeProfileText(message);
    return message;
  } catch {
    return 'Protected records installed runtime profile service proof failed; private path or credential details were suppressed.';
  }
}

function die(message, code = 1) {
  console.error(`ERROR: ${safeErrorMessage(message)}`);
  process.exit(code);
}

function readTextInput(path, label) {
  try {
    return path === '-' ? readFileSync(0, 'utf8') : readFileSync(path, 'utf8');
  } catch {
    die(`Could not read protected records installed runtime profile service proof ${label}.`);
  }
}

function readSampleArtifact() {
  return readCanonicalProtectedRecordsInstalledPreflightSampleArtifactText();
}

function readSampleProofArtifact() {
  try {
    return readFileSync(SAMPLE_PROOF_ARTIFACT_PATH, 'utf8');
  } catch {
    die(`Sample proof artifact is unavailable at ${SAMPLE_PROOF_ARTIFACT_DISPLAY_PATH}.`, 2);
  }
}

function runVerifyCommand(argv) {
  let inputPath = '';
  let useSample = false;
  let asJson = false;
  let requiredSha = '';

  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg === '--input') {
      inputPath = argv[++i] || '';
      if (!inputPath) {
        usage();
        die('Missing value for --input.', 2);
      }
    } else if (arg === '--sample') {
      useSample = true;
    } else if (arg === '--json') {
      asJson = true;
    } else if (arg === '--require-sha') {
      requiredSha = argv[++i] || '';
      if (!requiredSha) {
        usage();
        die('Missing value for --require-sha.', 2);
      }
    } else if (arg === '--help' || arg === '-h') {
      usage();
      process.exit(0);
    } else {
      usage();
      die('Unsupported verify option provided.', 2);
    }
  }

  if (inputPath && useSample) {
    usage();
    die('Cannot combine --input with --sample.', 2);
  }

  if (!inputPath && !useSample) {
    usage();
    die('Missing required --input <file|-> or --sample.', 2);
  }

  const artifact = parseProtectedRecordsInstalledRuntimeProfileServiceProofArtifactText(
    useSample ? readSampleProofArtifact() : readTextInput(inputPath, 'proof artifact')
  );
  const baseVerification = verifyProtectedRecordsInstalledRuntimeProfileServiceProofArtifact(
    artifact,
    { expectedArtifactBodySha256: requiredSha || null }
  );
  const verification = bindRequiredBodySha256(
    baseVerification,
    requiredSha,
    'Protected records installed runtime profile service proof artifact'
  );
  const output = asJson
    ? `${JSON.stringify(verification, null, 2)}\n`
    : formatProtectedRecordsInstalledRuntimeProfileServiceProofArtifactVerification(baseVerification) +
      formatRequiredBodySha256Posture(verification);
  assertNoUnsafeProtectedRecordsRuntimeProfileText(output);
  process.stdout.write(output);
}

const args = process.argv.slice(2);

if (args[0] === 'verify') {
  try {
    runVerifyCommand(args.slice(1));
  } catch (err) {
    die(err.message);
  }
  process.exit(0);
}

let inputPath = '';
let useSample = false;
let asJson = false;
let artifactOutput = '';

for (let i = 0; i < args.length; i++) {
  const arg = args[i];
  if (arg === '--input') {
    inputPath = args[++i] || '';
    if (!inputPath) {
      usage();
      die('Missing value for --input.', 2);
    }
  } else if (arg === '--sample') {
    useSample = true;
  } else if (arg === '--json') {
    asJson = true;
  } else if (arg === '--artifact') {
    artifactOutput = args[++i] || '';
    if (!artifactOutput) {
      usage();
      die('Missing value for --artifact.', 2);
    }
  } else if (arg === '--help' || arg === '-h') {
    usage();
    process.exit(0);
  } else {
    usage();
    die('Unsupported option provided.', 2);
  }
}

if (inputPath && useSample) {
  usage();
  die('Cannot combine --input with --sample.', 2);
}

if (!inputPath && !useSample) {
  usage();
  die('Missing required --input <file|-> or --sample.', 2);
}
if (artifactOutput === '-' && asJson) {
  usage();
  die('Cannot combine --json with --artifact -.', 2);
}

try {
  assertProtectedRecordsCurrentFixtureAuthorityGrantFreshEffectAllowed(
    'Protected records installed runtime profile service proof generation'
  );
} catch (err) {
  die(err.message);
}

try {
  const artifact = parseProtectedRecordsInstalledRuntimeProfilePreflightArtifactText(
    useSample ? readSampleArtifact() : readTextInput(inputPath, 'artifact')
  );
  const report = runProtectedRecordsInstalledRuntimeProfileServiceProof(artifact);
  assertProtectedRecordsInstalledRuntimeProfileServiceProof(report);
  let output;
  if (artifactOutput === '-') {
    const proofArtifact = buildProtectedRecordsInstalledRuntimeProfileServiceProofArtifact(report);
    assertProtectedRecordsInstalledRuntimeProfileServiceProofArtifact(proofArtifact);
    output = `${JSON.stringify(proofArtifact, null, 2)}\n`;
  } else {
    let proofArtifact = null;
    if (artifactOutput) {
      proofArtifact = buildProtectedRecordsInstalledRuntimeProfileServiceProofArtifact(report);
      writeProtectedRecordsInstalledRuntimeProfileServiceProofArtifact(
        proofArtifact,
        artifactOutput
      );
    }
    output = asJson
      ? `${JSON.stringify(report, null, 2)}\n`
      : formatProtectedRecordsInstalledRuntimeProfileServiceProofSummary(report);
    if (proofArtifact) {
      output += formatProtectedRecordsInstalledRuntimeProfileServiceProofArtifactSummary(proofArtifact);
    }
  }
  assertNoUnsafeProtectedRecordsRuntimeProfileText(output);
  process.stdout.write(output);
} catch (err) {
  die(err.message);
}
